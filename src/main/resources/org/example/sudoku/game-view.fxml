<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #F4F6F9; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.sudoku.controllers.GameController">
    <children>
        <!-- Título principal -->
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="6x6 Sudoku Game" />

        <!-- Tablero GridPane centrado -->
        <GridPane fx:id="sudokuGrid" alignment="CENTER" />

        <!-- Botones estilizados directamente -->
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="btnNewGame" onAction="#onNewGameClick" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 5; -fx-cursor: hand;" text="New Game" />
                <Button fx:id="btnHelp" onAction="#onHelpClick" style="-fx-background-color: #F1C40F; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 5; -fx-cursor: hand;" text="Help" />
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>